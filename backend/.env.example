# Copy to .env locally; never commit real credentials.
ATELIER_ACCESS_PASSWORD=replace-with-a-long-private-password
ATELIER_SESSION_SECRET=generate-a-random-secret-at-least-32-characters
HCNSEC_API_KEY=replace-with-a-new-provider-key
HCNSEC_MODEL=replace-with-an-exact-model-id

# Shared rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-a-private-token
